<?xml version="1.0" encoding="UTF-8"?>
<!-- [4.7] .NET 10 runtime bundling:
     Bootstrapper (Burn) that embeds the .NET 10 Desktop Runtime installer plus the
     product MSI into a single self-contained setup.exe. On install it:
       1. silently installs the bundled .NET 10 Desktop Runtime (the runtime installer
          itself no-ops if the version is already present), then
       2. installs the SDR-VST3 MSI.
     This replaces the old popup-and-download launch condition with an automatic,
     offline install for users who struggle to download the runtime themselves.

     Version binding: the bundle version is taken from the wrapped product MSI so the
     add/remove relationship and the file rename stay in lock-step with the product. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">

  <?if $(var.Platform) = x64 ?>
  <?define BundleUpgradeCode = "a3b9f4d1-7c2e-4a58-9b14-6d5f3e8a1c27"?>
  <?define BundleName = "SDR-VST3 (64-bit)" ?>
  <?else ?>
  <?define BundleUpgradeCode = "d5e8f1a2-3b7c-49d6-8f0a-2b9c4d5e6f71"?>
  <?define BundleName = "SDR-VST3 (32-bit)" ?>
  <?endif ?>

  <Bundle Name="$(var.BundleName)"
          Version="!(bind.PackageVersion.SDRVST3Product)"
          Manufacturer="OpenHPSDR"
          UpgradeCode="$(var.BundleUpgradeCode)"
          IconSourceFile="binary\Thetis.ico"
          AboutUrl="https://github.com">

    <!-- Standard bootstrapper UI showing the GPL license, then the install progress. -->
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtfLicense">
      <bal:WixStandardBootstrapperApplication
          LicenseFile="GNU_GENERAL_PUBLIC_LICENSE.rtf"
          LogoFile="binary\thetis_banner.bmp"
          SuppressOptionsUI="yes" />
    </BootstrapperApplicationRef>

    <!-- The .NET 10 Desktop Runtime is always installed to guarantee it is present.
         The runtime installer detects an existing matching version and no-ops quickly,
         and this deliberately avoids any registry/filesystem detection (which is not
         written reliably across all .NET installation methods). -->

    <Chain>
      <ExePackage Id="DotNet10Desktop"
                  Name=".NET 10 Desktop Runtime"
                  SourceFile="$(var.DotNetRuntime)"
                  InstallCommand="/install /quiet /norestart"
                  RepairCommand="/repair /quiet /norestart"
                  UninstallCommand="/uninstall /quiet /norestart"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes" />
      <MsiPackage Id="SDRVST3Product"
                  SourceFile="$(var.MsiPath)"
                  DisplayInternalUI="yes" />
    </Chain>
  </Bundle>
</Wix>
